DB_PORT=5432
DB_TIMEOUT=5000
POSTGRES_USER=adk_user
POSTGRES_PASSWORD=adk_password
POSTGRES_DB=adk_history

SESSION_SERVICE_URI=postgresql+asyncpg://adk_user:adk_password@postgres:5432/adk_history

# ==========================================
# FILE STORAGE CONFIGURATION
# ==========================================

# MAC USERS: Use your full absolute path (Do NOT use ~)
# OBSIDIAN_VAULT_PATH=/Users/yourusername/Desktop/your-vault

# WINDOWS USERS: Use your full absolute path (Forward slashes recommended)
# OBSIDIAN_VAULT_PATH=C:/Users/yourusername/Desktop/your-vault

OBSIDIAN_VAULT_PATH=your/actual/path/here

# ==========================================
# AI CONFIGS
# ==========================================

GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=XXX
GOOGLE_MODEL_NAME=gemini-3.1-pro-preview
GOOGLE_MODEL_NAME_2=gemini-2.5-flash-lite
GOOGLE_MODEL_NAME_3=gemini-2.5-flash

EMBEDDINGS_TYPE=google
EMBEDDINGS_MODEL_NAME=gemini-embedding-001
EMBEDDINGS_API_KEY=XXX


